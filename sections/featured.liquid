{{ 'featured.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured.js' | asset_url }}" defer></script>

<div class="featured-promo full-width">
  <p>{{ section.settings.promo_text }}</p>
</div>
<div class="featured-grid">
  {% for product in section.settings.featured_collection.products limit: 4 %}
    <a class="featured-product" href="{{ product.url }}"  data-product-handle="{{ product.handle }}">
      <img
        src="{{ product.featured_image | image_url: width: 800 }}"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
        alt="{{ product.featured_image.alt | escape }}"
      >
    </a>
  {% endfor %}
</div>


{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured collection"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promo text",
      "default": "10% OFF — Lorem ipsum dolor sit amet"
    }
  ]
}
{% endschema %}

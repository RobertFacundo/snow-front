{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

{{ 'cart.css' | asset_url | stylesheet_tag }}

<section class="cart-page full-width">
  <header
    class="cart-header full-width"
    {% if section.settings.header_image != blank %}
      style="background-image: url('{{ section.settings.header_image | image_url }}');"
    {% endif %}
  >
    <h1 class="cart-header__title">{{ 'cart.title' | t }}</h1>
  </header>

  <form class="cart-layout" action="{{ routes.cart_url }}" method="post">
    <div class="cart-layout__items">
      {% render 'cart-details' %}
    </div>

    <aside class="cart-layout__summary">
      {% render 'cart-summary' %}
    </aside>
  </form>
</section>
{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "image_picker",
      "id": "header_image",
      "label": "Header background image"
    }
  ]
}
{% endschema %}

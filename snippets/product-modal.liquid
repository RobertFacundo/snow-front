{{ 'product-modal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-modal.js' | asset_url }}" defer></script>

<dialog id="ProductModal" class="product-modal">
  <div class="product-modal__content">
    <button
      type="button"
      class="product-modal__close"
      aria-label="Close"
    >
      ×
    </button>

    <div class="product-modal__body">
      <!-- Product content will be rendered here -->
    </div>
  </div>
</dialog>
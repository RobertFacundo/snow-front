{{ 'product-header.css' | asset_url | stylesheet_tag }}

<section
  class="product-header full-width"
  {% if header_image %}
    style="--product-header-image: url('{{ header_image | image_url: width: 2000 }}');"
  {% endif %}
>
  <div class="product-header__breadcrumb">
    {% render 'breadcrumb' %}
  </div>

  <div class="product-header__content">
    <h1 class="product-header__title">
      {{ collection.title }}
    </h1>

    {% if collection.description != blank %}
      <div class="product-header__description">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>
</section>